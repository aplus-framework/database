parameters:
    level: 7
    paths:
        - src
        - tests
    ignoreErrors:
        - identifier: staticMethod.alreadyNarrowedType
        - '#Access to an undefined property object::\$[a-zA-Z0-9_]+\.#'
        - '#Access to an uninitialized readonly property Aplus\\Database\\Result\\Field::#'
        - '#Call to protected method sql\(\) of class Aplus\\Database\\Definition\\Table\\Columns\\Column\.#'
        - '#Call to protected method sql\(\) of class Aplus\\Database\\Definition\\Table\\Indexes\\IndexDefinition\.#'
        - '#Call to protected method sql\(\) of class Aplus\\Database\\Definition\\Table\\Indexes\\Index\.#'
        - '#Call to protected method sql\(\) of class Aplus\\Database\\Definition\\Table\\TableDefinition\.#'
        - '#Class Aplus\\Database\\Result\\Field has an uninitialized readonly property#'
        - '#Readonly property Aplus\\Database\\Result\\Field::\$[a-zA-Z0-9_]+ is assigned outside of the constructor.#'
